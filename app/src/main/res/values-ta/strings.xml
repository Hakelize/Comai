    <!-- Onboarding Steps -->
    <string name="ob_welcome_title">COMAI-ஐ சந்திக்கவும்</string>
    <string name="ob_welcome_desc">உங்கள் வழக்கத்தை அறிந்து, உங்கள் நாளைப் புரிந்து, சரியான நேரத்தில் உதவும் உங்கள் தனிப்பட்ட AI தோழன்.</string>
    <string name="ob_features_title">COMAI என்ன செய்ய முடியும்</string>
    <string name="ob_features_sub">உங்கள் நாளைப் புரிந்து உங்கள் வாழ்க்கைக்குப் பொருந்தும் ஒரு தோழன்.</string>
    <string name="ob_f1_title">COMAI உங்கள் வழக்கத்தை அறிந்துகொள்ளும்</string>
    <string name="ob_f1_desc">காலப்போக்கில், உங்கள் வழக்கமான அட்டவணை, இடங்கள் மற்றும் பழக்கவழக்கங்களை COMAI புரிந்துகொள்கிறது.</string>
    <string name="ob_f2_title">முக்கியமானவற்றை COMAI நினைவில் வைத்திருக்கும்</string>
    <string name="ob_f2_desc">எதை நினைவில் வைத்திருக்க வேண்டும் என்பதை நீங்கள் கூறலாம்; உங்கள் நினைவுகளின் முழு கட்டுப்பாடு உங்களுக்கே.</string>
    <string name="ob_f3_title">மாற்றங்கள் ஏற்படும்போது COMAI உதவும்</string>
    <string name="ob_f3_desc">வழக்கத்திலிருந்து ஏதேனும் மாறினால், COMAI விசாரித்து உதவ முடியும்.</string>
    <string name="ob_lang_title">COMAI-உடன் நீங்கள் எப்படி பேச விரும்புகிறீர்கள்?</string>
    <string name="ob_lang_sub">COMAI குரல் மற்றும் இடைமுகத்திற்கான உங்கள் விருப்பமான மொழியைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="ob_voice_title">குரல் அமைப்பு</string>
    <string name="ob_voice_sub">COMAI-உடன் இயல்பாகப் பேச மைக்ரோஃபோன் அனுமதியை அனுமதிக்கவும்.</string>
    <string name="ob_voice_btn">மைக்ரோஃபோன் அணுகலை அனுமதிக்கவும்</string>
    <string name="ob_voice_skip">குரல் இல்லாமல் தொடரவும்</string>
    <string name="ob_profile_title">உங்களைப் பற்றி தெரிந்துகொள்ளலாம்</string>
    <string name="ob_profile_sub">சரியான தருணங்களில் உதவ உங்கள் அட்டவணையை COMAI-க்கு தெரிவிக்கவும்.</string>
